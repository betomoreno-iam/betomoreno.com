---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.year - a.data.year);

const statusLabel: Record<string, string> = {
  shipped: 'Shipped',
  ongoing: 'Ongoing',
  archived: 'Archived',
};
---

<Base title="Projects" description="Selected projects and work by Beto Moreno.">
  <div class="container page">
    <header class="page-header">
      <h1>Projects</h1>
      <p>Selected work</p>
    </header>

    {projects.length > 0 ? (
      <div class="projects-list">
        {projects.map(project => (
          <article class="project-row">
            <div class="project-main">
              <div class="project-title-row">
                <h3>
                  {project.data.url ? (
                    <a href={project.data.url} target="_blank" rel="noopener noreferrer">{project.data.title}</a>
                  ) : (
                    <a href={`/projects/${project.id}/`}>{project.data.title}</a>
                  )}
                </h3>
                <span class={`status status--${project.data.status}`}>{statusLabel[project.data.status]}</span>
              </div>
              <p class="project-description">{project.data.description}</p>
              <div class="project-meta">
                <span class="year">{project.data.year}</span>
                <span class="role">{project.data.role}</span>
                {project.data.tags.slice(0, 3).map(tag => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty">No projects yet.</p>
    )}
  </div>
</Base>

<style>
  .page {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .page-header {
    margin-bottom: 1.5rem;
  }

  h1 {
    font-size: 1.75rem;
    margin-bottom: 0.25rem;
  }

  .page-header p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .projects-list {
    border-top: 1px solid var(--color-border);
  }

  .project-row {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .project-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.375rem;
  }

  h3 {
    font-size: 1rem;
    font-weight: 500;
    margin: 0;
  }

  h3 a {
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition);
  }

  h3 a:hover {
    color: var(--color-accent);
  }

  .project-description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0 0 0.5rem;
    line-height: 1.55;
  }

  .project-meta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    flex-wrap: wrap;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
  }

  .year {
    font-variant-numeric: tabular-nums;
  }

  .role {
    color: var(--color-text-muted);
  }

  .status {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.175em 0.5em;
    border-radius: 3px;
  }

  .status--shipped {
    color: #166534;
    background-color: #dcfce7;
  }

  .status--ongoing {
    color: #1e40af;
    background-color: #dbeafe;
  }

  .status--archived {
    color: var(--color-text-muted);
    background-color: var(--color-bg-alt);
  }

  :global([data-theme='dark']) .status--shipped {
    color: #86efac;
    background-color: #14532d;
  }

  :global([data-theme='dark']) .status--ongoing {
    color: #93c5fd;
    background-color: #1e3a5f;
  }

  .empty {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }
</style>
