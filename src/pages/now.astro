---
import Base from '../layouts/Base.astro';

const lastUpdated = new Date('2026-05-18');
---

<Base title="Now" description="What Beto Moreno is focused on right now.">
  <article class="container page" data-pagefind-body>
    <header class="page-header">
      <h1>Now</h1>
      <p class="updated">
        Updated {lastUpdated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        · <a href="https://nownownow.com/about" target="_blank" rel="noopener">What is this?</a>
      </p>
    </header>

    <div class="prose">
      <h2>Work</h2>
      <p>
        [What you're currently working on at Deel or professionally — be specific and update this regularly]
      </p>

      <h2>Learning</h2>
      <p>
        [What you're reading, studying, or exploring right now]
      </p>

      <h2>Personal</h2>
      <p>
        [What's going on in your personal life that you're comfortable sharing]
      </p>
    </div>
  </article>
</Base>

<style>
  .page {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  h1 {
    font-size: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .updated {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    margin: 0;
  }

  .updated a {
    color: var(--color-text-muted);
  }
</style>
