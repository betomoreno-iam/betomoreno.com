---
import Base from '../layouts/Base.astro';
---

<Base title="Resume" description="Career history and experience of Beto Moreno, product manager.">
  <article class="container page" data-pagefind-body>
    <header class="page-header">
      <h1>Resume</h1>
      <p class="tagline">Product Manager · [Your City] · <a href="mailto:hello@betomoreno.com">hello@betomoreno.com</a></p>
    </header>

    <div class="resume-body">

      <section class="resume-section">
        <h2>Experience</h2>

        <div class="role">
          <div class="role-header">
            <div>
              <h3>Senior Product Manager</h3>
              <span class="company"><a href="https://www.deel.com" target="_blank" rel="noopener">Deel</a></span>
            </div>
            <span class="period">2023 — Present</span>
          </div>
          <ul>
            <li>[Key achievement or responsibility — be specific, use numbers when possible]</li>
            <li>[Key achievement or responsibility]</li>
            <li>[Key achievement or responsibility]</li>
          </ul>
        </div>

        <div class="role">
          <div class="role-header">
            <div>
              <h3>[Previous Title]</h3>
              <span class="company">[Previous Company]</span>
            </div>
            <span class="period">[Years]</span>
          </div>
          <ul>
            <li>[Key achievement]</li>
            <li>[Key achievement]</li>
          </ul>
        </div>

      </section>

      <hr class="divider" />

      <section class="resume-section">
        <h2>Education</h2>
        <div class="role">
          <div class="role-header">
            <div>
              <h3>[Degree]</h3>
              <span class="company">[University]</span>
            </div>
            <span class="period">[Year]</span>
          </div>
        </div>
      </section>

      <hr class="divider" />

      <section class="resume-section">
        <h2>Skills</h2>
        <div class="skills-grid">
          <div>
            <h4>Product</h4>
            <p>Discovery, strategy, roadmapping, stakeholder alignment, metrics</p>
          </div>
          <div>
            <h4>Process</h4>
            <p>Agile, continuous discovery, OKRs, user research, A/B testing</p>
          </div>
          <div>
            <h4>Tools</h4>
            <p>Figma, Linear, Amplitude, Mixpanel, SQL, Notion</p>
          </div>
        </div>
      </section>

    </div>
  </article>
</Base>

<style>
  .page {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: 1.75rem;
    margin-bottom: 0.375rem;
  }

  .tagline {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .resume-section {
    margin-bottom: 2.5rem;
  }

  h2 {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.125rem;
  }

  h4 {
    font-size: 0.875rem;
    font-weight: 600;
    margin: 0 0 0.25rem;
  }

  .role {
    margin-bottom: 2rem;
  }

  .role-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .company {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .company a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .company a:hover {
    color: var(--color-accent);
  }

  .period {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    font-family: var(--font-sans);
  }

  ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  li {
    font-size: 0.9375rem;
    color: var(--color-text);
    margin-bottom: 0.375rem;
    line-height: 1.6;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .skills-grid p {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.55;
  }
</style>
