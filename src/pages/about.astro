---
import Base from '../layouts/Base.astro';
---

<Base title="About" description="About Beto Moreno — product manager, thinker, writer.">
  <article class="container page" data-pagefind-body>
    <header class="page-header">
      <h1>About</h1>
    </header>

    <div class="prose">
      <p>
        I'm Beto Moreno, a product manager based in [your city]. I currently work at
        <a href="https://www.deel.com" target="_blank" rel="noopener">Deel</a>, where I [short description of what you do there].
      </p>

      <p>
        Before Deel, [brief career background — one or two sentences].
      </p>

      <p>
        I write about product management, strategy, how teams make decisions, and occasionally
        things completely unrelated to work. The goal is to think in public — to put ideas somewhere
        they can sharpen over time.
      </p>

      <h2>What I'm working on</h2>
      <p>
        See the <a href="/now">Now page</a> for what I'm focused on at the moment.
      </p>

      <h2>Elsewhere</h2>
      <ul>
        <li><a href="https://linkedin.com/in/betomoreno" target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href="https://twitter.com/betomoreno" target="_blank" rel="noopener">X / Twitter</a></li>
        <li><a href="https://github.com/betomoreno-iam" target="_blank" rel="noopener">GitHub</a></li>
      </ul>

      <h2>This site</h2>
      <p>
        Built with <a href="https://astro.build" target="_blank" rel="noopener">Astro</a>,
        hosted on <a href="https://pages.cloudflare.com" target="_blank" rel="noopener">Cloudflare Pages</a>.
        Content written in Markdown. Source on <a href="https://github.com/betomoreno-iam/betomoreno.com" target="_blank" rel="noopener">GitHub</a>.
      </p>
    </div>
  </article>
</Base>

<style>
  .page {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .page-header {
    margin-bottom: 2rem;
  }

  h1 {
    font-size: 1.75rem;
    margin-bottom: 0;
  }
</style>
