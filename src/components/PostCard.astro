---
import FormattedDate from './FormattedDate.astro';

interface Props {
  href: string;
  title: string;
  date?: Date;
  description?: string;
  tags?: string[];
}

const { href, title, date, description, tags = [] } = Astro.props;
---

<article class="post-card">
  <a href={href} class="post-link">
    <h3 class="post-title">{title}</h3>
    {description && <p class="post-description">{description}</p>}
    <div class="post-meta">
      {date && <FormattedDate date={date} />}
      {tags.length > 0 && (
        <span class="tags">
          {tags.slice(0, 3).map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </span>
      )}
    </div>
  </a>
</article>

<style>
  .post-card {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .post-card:last-child {
    border-bottom: none;
  }

  .post-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .post-link:hover .post-title {
    color: var(--color-accent);
  }

  .post-title {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 500;
    margin: 0 0 0.375rem;
    color: var(--color-text);
    transition: color var(--transition);
    line-height: 1.35;
  }

  .post-description {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0 0 0.5rem;
    line-height: 1.55;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    font-family: var(--font-sans);
  }

  .tags {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }
</style>
